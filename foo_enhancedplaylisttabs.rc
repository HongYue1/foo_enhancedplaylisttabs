    LTEXT           "",IDC_TITLE_PREVIEW,12,77,281,8,SS_NOPREFIX | SS_ENDELLIPSIS

    LTEXT           "Fields for tab titles (track fields such as %artist% stay empty: a tab has no track)",IDC_STATIC,7,89,286,8,SS_NOPREFIX
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,99,286,1
    LTEXT           "%title%, %playlist_name%",IDC_STATIC,12,104,96,8,SS_NOPREFIX
    LTEXT           "The playlist's name",IDC_STATIC,111,104,182,8,SS_NOPREFIX
    LTEXT           "%index%",IDC_STATIC,12,113,96,8,SS_NOPREFIX
    LTEXT           "Position among the playlists: 1, 2, 3...",IDC_STATIC,111,113,182,8,SS_NOPREFIX
    LTEXT           "%size%, %list_total%",IDC_STATIC,12,122,96,8,SS_NOPREFIX
    LTEXT           "Number of tracks in the playlist",IDC_STATIC,111,122,182,8,SS_NOPREFIX
    LTEXT           "%length%",IDC_STATIC,12,131,96,8,SS_NOPREFIX
    LTEXT           "Total length of the tracks: 1:02:03",IDC_STATIC,111,131,182,8,SS_NOPREFIX
    LTEXT           "%is_active%",IDC_STATIC,12,140,96,8,SS_NOPREFIX
    LTEXT           "1 for the active playlist",IDC_STATIC,111,140,182,8,SS_NOPREFIX
    LTEXT           "%isplaying%",IDC_STATIC,12,149,96,8,SS_NOPREFIX
    LTEXT           "1 while this playlist plays or is paused",IDC_STATIC,111,149,182,8,SS_NOPREFIX
    LTEXT           "%ispaused%",IDC_STATIC,12,158,96,8,SS_NOPREFIX
    LTEXT           "1 while this playlist is paused",IDC_STATIC,111,158,182,8,SS_NOPREFIX
    LTEXT           "%playlist_is_playing%",IDC_STATIC,12,167,96,8,SS_NOPREFIX
    LTEXT           "1 for the playing playlist, also after stop",IDC_STATIC,111,167,182,8,SS_NOPREFIX
    LTEXT           "%is_locked%",IDC_STATIC,12,176,96,8,SS_NOPREFIX
    LTEXT           "1 for a locked playlist (an autoplaylist...)",IDC_STATIC,111,176,182,8,SS_NOPREFIX
    LTEXT           "%lock_name%",IDC_STATIC,12,185,96,8,SS_NOPREFIX
    LTEXT           "What locks it, such as ""Autoplaylist""",IDC_STATIC,111,185,182,8,SS_NOPREFIX
    LTEXT           "%queue_total%",IDC_STATIC,12,194,96,8,SS_NOPREFIX
    LTEXT           "Number of tracks in the playback queue",IDC_STATIC,111,194,182,8,SS_NOPREFIX
    LTEXT           "%playlist_queue_total%",IDC_STATIC,12,203,96,8,SS_NOPREFIX
    LTEXT           "Queued tracks from this playlist",IDC_STATIC,111,203,182,8,SS_NOPREFIX
END

IDD_PAGE_BEHAVIOUR DIALOGEX 0, 0, 300, 218
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
