    LTEXT           "DIPs (0 = automatic, 1-8)",IDC_STATIC,131,141,162,8
    LTEXT           "Line opacity:",IDC_STATIC,12,157,84,8
    CONTROL         "Automatic",IDC_HOVER_LINE_AUTO,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,99,156,52,10
    CONTROL         "",IDC_HOVER_LINE,"msctls_trackbar32",TBS_HORZ | TBS_NOTICKS | WS_TABSTOP,153,154,108,14
    LTEXT           "",IDC_HOVER_LINE_VALUE,265,157,28,8

    LTEXT           "Animation",IDC_STATIC,7,178,286,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,188,286,1
    CONTROL         "Fade in and out",IDC_HOVER_FADE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,196,84,10
    EDITTEXT        IDC_HOVER_FADE_MS,99,195,28,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "ms (50-1000)",IDC_STATIC,131,197,162,8
END

IDD_PAGE_COLOURS DIALOGEX 0, 0, 300, 218
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "Microsoft Sans Serif", 400, 0, 0x0
BEGIN
    LTEXT           "Accent",IDC_STATIC,7,4,286,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,14,286,1
