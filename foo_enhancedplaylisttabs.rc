    LTEXT           "RRGGBB",IDC_STATIC,171,39,122,8
    LTEXT           "Marks the active tab, selected tabs and, if chosen, the hovered tab. Kept legible against the strip.",IDC_STATIC,12,53,281,16

    LTEXT           "Strip background",IDC_STATIC,7,81,286,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,91,286,1
    LTEXT           "Background:",IDC_STATIC,12,100,84,8
