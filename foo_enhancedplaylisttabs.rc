/////////////////////////////////////////////////////////////////////////////
// Rename: modal, from the strip's right-click menu.

IDD_RENAME DIALOGEX 0, 0, 250, 50
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Rename playlist"
FONT 8, "Microsoft Sans Serif", 400, 0, 0x0
BEGIN
    LTEXT           "Name:",IDC_STATIC,7,9,36,8
    EDITTEXT        IDC_RENAME_TITLE,46,7,198,12,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK",IDOK,140,29,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,194,29,50,14
END

IDD_CONFIRM DIALOGEX 0, 0, 250, 62
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Confirm"
FONT 8, "Microsoft Sans Serif", 400, 0, 0x0
BEGIN
