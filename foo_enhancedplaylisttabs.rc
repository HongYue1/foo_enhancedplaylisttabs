// Enhanced Playlist Tabs resources. Hand-written, not generated. Coordinates are dialog units.

#include "resource.h"
#include "winres.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)

// Dialog style profile (keep every page consistent with this):
//   sections : header + etched line, no group boxes, no bold
//   fields   : labels in a left column (84 DU, field at 99), noun + colon
//   rhythm   : check boxes 14 DU apart, field rows 16 DU, 12 DU before a new section header
//   labels   : short; beside a number only its unit ("px", "ms"). Ranges, what 0 or Automatic
//              means and anything not clear at first glance go in the control's tooltip (the
//              tips table in configure_dialog.cpp; it shows on the label too). No notes, no footers
//   automatic: an "Automatic" check box before the slider or edit it sets (never "Auto")
//   columns  : one column 7..293; content indented 5. The Hover page alone has two (other
//              tabs | active tab, labels 62 DU, fields at 77 and 187)
//   colours  : "<thing> colour:" combo, then "Custom colour:" hex edit + swatch button that opens
//              the colour picker
//   sliders  : strengths 2-100 %, value right of the slider

/////////////////////////////////////////////////////////////////////////////
// Configure: per container, modeless beside the element (modal from Columns UI's Layout page). The strip, the area the pages are placed in (IDC_PAGE_HOST,
// never shown) and the buttons.

IDD_CONFIGURE DIALOGEX 0, 0, 300, 270
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Enhanced Playlist Tabs"
FONT 8, "Microsoft Sans Serif", 400, 0, 0x0
BEGIN
    CONTROL         "",IDC_TABS,"SysTabControl32",WS_CLIPSIBLINGS | WS_TABSTOP,7,7,286,17
    LTEXT           "",IDC_PAGE_HOST,0,28,300,218,NOT WS_VISIBLE
    PUSHBUTTON      "Defaults",IDC_DEFAULTS,7,250,50,14
    DEFPUSHBUTTON   "OK",IDOK,189,250,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,243,250,50,14
END

// Pages: child dialogs, 300 x 218, created once and shown one at a time, in tab order (the
// page list in configure_dialog.cpp).

IDD_PAGE_STRIP DIALOGEX 0, 0, 300, 218
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "Microsoft Sans Serif", 400, 0, 0x0
