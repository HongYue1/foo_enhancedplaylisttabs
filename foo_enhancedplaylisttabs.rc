    CONTROL         "Rotate the text on side strips",IDC_ROTATE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,54,281,10
    LTEXT           "Tabs",IDC_STATIC,7,75,286,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,85,286,1
